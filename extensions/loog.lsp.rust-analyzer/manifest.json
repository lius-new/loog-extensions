{
  "schema": 1,
  "id": "loog.lsp.rust-analyzer",
  "version": "0.1.4",
  "api": "loog:extension@0.1.0",
  "component": "extension.wasm",
  "activation": [{ "kind": "document", "selector": { "languages": ["rust"] } }, { "kind": "event", "name": "workspace.files" }, { "kind": "event", "name": "document.open" }, { "kind": "event", "name": "document.change" }, { "kind": "event", "name": "document.close" }, { "kind": "event", "name": "document.save" }],
  "name": "rust-analyzer Language Server",
  "publisher": "Loog",
  "description": "The rust-analyzer language server.",
  "categories": [
    "Language Services"
  ],
  "keywords": [
    "rust-analyzer",
    "language server",
    "lsp"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": "https://github.com/lius-new/loog-extensions",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {
    "loog": ">=0.1.10 <0.3"
  },
  "capabilities": [
    "process.execute-local", "documents.read", "workspace.files.read", "workspace.files.write", "workspace.edit", "languages", "events", "settings"
  ],
  "contributes": {
    "languages": [{ "id": "loog.lsp.rust-analyzer.language", "path": "languages/rust/language.json" }],
    "settings": [
      { "key": "loog.lsp.rust-analyzer.configuration", "kind": "string", "default": "{}" },
      { "key": "loog.lsp.rust-analyzer.initialization", "kind": "string", "default": "{}" },
      { "key": "loog.lsp.rust-analyzer.performance", "kind": "boolean", "default": false }
    ],
    "language_service": {
      "name": "Rust Analyzer",
      "providers": [
        { "id": "loog.lsp.rust-analyzer.diagnostics", "kind": "diagnostics", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.completion", "kind": "completion", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.hover", "kind": "hover", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.definition", "kind": "definition", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.document-symbols", "kind": "document-symbols", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.signature-help", "kind": "signature-help", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.formatting", "kind": "formatting", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.inlay-hints", "kind": "inlay-hints", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.code-actions", "kind": "code-actions", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.references", "kind": "references", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.workspace-symbols", "kind": "workspace-symbols", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.document-highlights", "kind": "document-highlights", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.rename", "kind": "rename", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.folding-ranges", "kind": "folding-ranges", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.selection-ranges", "kind": "selection-ranges", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.call-hierarchy", "kind": "call-hierarchy", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.type-hierarchy", "kind": "type-hierarchy", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.code-lens", "kind": "code-lens", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.format-on-type", "kind": "format-on-type", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.execute-command", "kind": "execute-command", "selector": { "languages": ["rust"] } },
        { "id": "loog.lsp.rust-analyzer.highlights", "kind": "highlights", "selector": { "languages": ["rust"] } }
      ]
    }
  }
}
