{
  "schema": 1,
  "id": "loog.remote.docker",
  "version": "0.1.0",
  "api": "loog:extension@0.1.0",
  "component": "extension.wasm",
  "name": "Remote Containers",
  "publisher": "Loog",
  "description": "Open a folder inside a running Docker container.",
  "license": "MIT OR Apache-2.0",
  "categories": ["Productivity"],
  "keywords": ["Docker", "container", "remote", "workspace"],
  "repository": "https://github.com/lius-new/loog-extensions",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {"loog": ">=0.1.10 <0.3"},
  "capabilities": ["workspace.provide", "process.execute-tool", "storage"],
  "activation": [
    {"kind": "event", "name": "application.start"},
    {"kind": "event", "name": "workspace.restore"},
    {"kind": "command", "id": "loog.remote.docker.connect"},
    {"kind": "command", "id": "loog.remote.docker.disconnect"}
  ],
  "contributes": {
    "commands": [
      {"id": "loog.remote.docker.connect", "title": "Remote Containers: Connect to Container…", "context": "window"},
      {"id": "loog.remote.docker.disconnect", "title": "Remote Containers: Disconnect", "context": "window"}
    ]
  }
}
