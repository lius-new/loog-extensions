{
  "schema": 1,
  "id": "loog.lsp.clangd",
  "version": "0.1.4",
  "api": "loog:extension@0.1.0",
  "component": "extension.wasm",
  "activation": [{ "kind": "document", "selector": { "languages": ["c","cpp"] } }, { "kind": "event", "name": "workspace.files" }, { "kind": "event", "name": "document.open" }, { "kind": "event", "name": "document.change" }, { "kind": "event", "name": "document.close" }, { "kind": "event", "name": "document.save" }],
  "name": "clangd",
  "publisher": "Loog",
  "description": "C and C++ language services powered by clangd.",
  "categories": [
    "Language Services"
  ],
  "keywords": [
    "c",
    "language server",
    "lsp"
  ],
  "license": "Apache-2.0 WITH LLVM-exception",
  "repository": "https://github.com/lius-new/loog-extensions",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {
    "loog": ">=0.2.0 <0.3"
  },
  "capabilities": [
    "process.execute-local", "documents.read", "workspace.files.read", "workspace.files.write", "workspace.edit", "languages", "events", "settings"
  ],
  "contributes": {
    "languages": [
      { "id": "loog.lsp.clangd.c", "path": "languages/c/language.json" },
      { "id": "loog.lsp.clangd.cpp", "path": "languages/cpp/language.json" }
    ],
    "settings": [
      { "key": "loog.lsp.clangd.configuration", "kind": "string", "default": "{}" },
      { "key": "loog.lsp.clangd.initialization", "kind": "string", "default": "{}" },
      { "key": "loog.lsp.clangd.performance", "kind": "boolean", "default": false }
    ],
    "language_service": {
      "name": "clangd",
      "providers": [
        { "id": "loog.lsp.clangd.diagnostics", "kind": "diagnostics", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.completion", "kind": "completion", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.hover", "kind": "hover", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.definition", "kind": "definition", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.document-symbols", "kind": "document-symbols", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.signature-help", "kind": "signature-help", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.formatting", "kind": "formatting", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.inlay-hints", "kind": "inlay-hints", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.code-actions", "kind": "code-actions", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.references", "kind": "references", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.workspace-symbols", "kind": "workspace-symbols", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.document-highlights", "kind": "document-highlights", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.rename", "kind": "rename", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.folding-ranges", "kind": "folding-ranges", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.selection-ranges", "kind": "selection-ranges", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.call-hierarchy", "kind": "call-hierarchy", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.type-hierarchy", "kind": "type-hierarchy", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.code-lens", "kind": "code-lens", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.format-on-type", "kind": "format-on-type", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.execute-command", "kind": "execute-command", "selector": { "languages": ["c","cpp"] } },
        { "id": "loog.lsp.clangd.highlights", "kind": "highlights", "selector": { "languages": ["c","cpp"] } }
      ]
    }
  }
}
