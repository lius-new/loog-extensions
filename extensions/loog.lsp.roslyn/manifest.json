{
  "schema": 1,
  "id": "loog.lsp.roslyn",
  "version": "0.1.0",
  "api": "loog:extension@0.1.0",
  "component": "extension.wasm",
  "activation": [{ "kind": "document", "selector": { "languages": ["csharp"] } }, { "kind": "event", "name": "workspace.files" }, { "kind": "event", "name": "document.open" }, { "kind": "event", "name": "document.change" }, { "kind": "event", "name": "document.close" }, { "kind": "event", "name": "document.save" }],
  "name": "Roslyn Language Server",
  "publisher": "Loog",
  "description": "C# completion, diagnostics and navigation powered by Microsoft Roslyn.",
  "categories": [
    "Language Services"
  ],
  "keywords": [
    "csharp",
    "language server",
    "lsp"
  ],
  "license": "MIT",
  "repository": "https://github.com/lius-new/loog-extensions",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {
    "loog": ">=0.2.0 <0.3"
  },
  "capabilities": [
    "process.execute-local", "documents.read", "workspace.files.read", "workspace.files.write", "workspace.edit", "languages", "events", "settings"
  ],
  "contributes": {
    "languages": [
      { "id": "loog.lsp.roslyn.csharp", "path": "languages/csharp/language.json" }
    ],
    "settings": [
      { "key": "loog.lsp.roslyn.configuration", "kind": "string", "default": "{}" },
      { "key": "loog.lsp.roslyn.initialization", "kind": "string", "default": "{}" },
      { "key": "loog.lsp.roslyn.performance", "kind": "boolean", "default": false }
    ],
    "language_service": {
      "name": "Roslyn Language Server",
      "providers": [
        { "id": "loog.lsp.roslyn.diagnostics", "kind": "diagnostics", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.completion", "kind": "completion", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.hover", "kind": "hover", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.definition", "kind": "definition", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.document-symbols", "kind": "document-symbols", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.signature-help", "kind": "signature-help", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.formatting", "kind": "formatting", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.inlay-hints", "kind": "inlay-hints", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.code-actions", "kind": "code-actions", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.references", "kind": "references", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.workspace-symbols", "kind": "workspace-symbols", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.document-highlights", "kind": "document-highlights", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.rename", "kind": "rename", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.folding-ranges", "kind": "folding-ranges", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.selection-ranges", "kind": "selection-ranges", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.call-hierarchy", "kind": "call-hierarchy", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.type-hierarchy", "kind": "type-hierarchy", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.code-lens", "kind": "code-lens", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.format-on-type", "kind": "format-on-type", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.execute-command", "kind": "execute-command", "selector": { "languages": ["csharp"] } },
        { "id": "loog.lsp.roslyn.highlights", "kind": "highlights", "selector": { "languages": ["csharp"] } }
      ]
    }
  }
}
