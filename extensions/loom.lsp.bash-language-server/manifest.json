{
  "schema": 1,
  "id": "loom.lsp.bash-language-server",
  "version": "0.1.0",
  "name": "Bash Language Server Language Server",
  "publisher": "Loom",
  "description": "The Bash Language Server language server.",
  "categories": [
    "Language Services"
  ],
  "keywords": [
    "bash language server",
    "language server",
    "lsp"
  ],
  "license": "MIT",
  "repository": "https://github.com/lius-new/loom-extensions",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {
    "loom": ">=0.1.8 <0.3"
  },
  "capabilities": [
    "process.execute-local"
  ],
  "requires": [
    "loom.runtime.node@^0.1.0"
  ],
  "contributes": {
    "language_service": {
      "servers": [
        {
          "id": "loom.lsp.bash-language-server.bash-language-server",
          "name": "Bash Language Server",
          "languages": [
            "bash"
          ],
          "command": "${runtime.node}/node",
          "args": [
            "${extension}/node_modules/bash-language-server/out/cli.js",
            "start"
          ],
          "root_markers": [
            ".git"
          ],
          "root_strategy": "nearest",
          "root_fallback": "workspace",
          "bindings": [
            {
              "language": "bash",
              "language_id": "shellscript"
            }
          ]
        }
      ]
    }
  }
}
