{
  "schema": 1,
  "id": "loog.lsp.biome",
  "version": "0.1.6",
  "api": "loog:extension@0.1.0",
  "component": "extension.wasm",
  "activation": [{ "kind": "document", "selector": { "languages": ["javascript", "typescript", "json", "css"] } }, { "kind": "event", "name": "workspace.files" }, { "kind": "event", "name": "document.open" }, { "kind": "event", "name": "document.change" }, { "kind": "event", "name": "document.close" }, { "kind": "event", "name": "document.save" }],
  "name": "Biome Language Server",
  "publisher": "Loog",
  "description": "Biome linting and formatting for JavaScript, TypeScript, JSON and CSS.",
  "categories": [
    "Language Services"
  ],
  "keywords": [
    "biome",
    "language server",
    "lsp"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": "https://github.com/lius-new/loog-extensions",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {
    "loog": ">=0.2.0 <0.3"
  },
  "capabilities": [
    "process.execute-local", "documents.read", "workspace.files.read", "workspace.files.write", "workspace.edit", "languages", "events", "settings"
  ],
  "contributes": {
    "languages": [
      { "id": "loog.lsp.biome.javascript", "path": "languages/javascript/language.json" },
      { "id": "loog.lsp.biome.typescript", "path": "languages/typescript/language.json" },
      { "id": "loog.lsp.biome.json", "path": "languages/json/language.json" },
      { "id": "loog.lsp.biome.css", "path": "languages/css/language.json" }
    ],
    "settings": [
      { "key": "loog.lsp.biome.configuration", "kind": "string", "default": "{}" },
      { "key": "loog.lsp.biome.initialization", "kind": "string", "default": "{}" },
      { "key": "loog.lsp.biome.performance", "kind": "boolean", "default": false }
    ],
    "language_service": {
      "name": "Biome Language Server",
      "providers": [
        { "id": "loog.lsp.biome.diagnostics", "kind": "diagnostics", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.completion", "kind": "completion", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.hover", "kind": "hover", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.definition", "kind": "definition", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.document-symbols", "kind": "document-symbols", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.signature-help", "kind": "signature-help", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.formatting", "kind": "formatting", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.inlay-hints", "kind": "inlay-hints", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.code-actions", "kind": "code-actions", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.references", "kind": "references", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.workspace-symbols", "kind": "workspace-symbols", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.document-highlights", "kind": "document-highlights", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.rename", "kind": "rename", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.folding-ranges", "kind": "folding-ranges", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.selection-ranges", "kind": "selection-ranges", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.call-hierarchy", "kind": "call-hierarchy", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.type-hierarchy", "kind": "type-hierarchy", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.code-lens", "kind": "code-lens", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.format-on-type", "kind": "format-on-type", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.execute-command", "kind": "execute-command", "selector": { "languages": ["javascript", "typescript", "json", "css"] } },
        { "id": "loog.lsp.biome.highlights", "kind": "highlights", "selector": { "languages": ["javascript", "typescript", "json", "css"] } }
      ]
    }
  }
}
