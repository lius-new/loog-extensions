{
  "schema": 1,
  "id": "loom.lsp.typescript-language-server",
  "version": "0.1.2",
  "name": "TypeScript Language Server Language Server",
  "publisher": "Loom",
  "description": "The TypeScript Language Server language server.",
  "categories": [
    "Languages"
  ],
  "keywords": [
    "typescript language server",
    "language server",
    "lsp"
  ],
  "license": "Apache-2.0",
  "repository": "https://github.com/lius-new/loom-extensions",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {
    "loom": ">=0.1.8 <0.3"
  },
  "capabilities": [
    "process.execute-local"
  ],
  "requires": [
    "loom.runtime.node@^0.1.0"
  ],
  "contributes": {
    "language_service": {
      "servers": [
        {
          "id": "loom.lsp.typescript-language-server.typescript-language-server",
          "name": "TypeScript Language Server",
          "languages": [
            "javascript",
            "typescript"
          ],
          "command": "${runtime.node}/node",
          "args": [
            "${extension}/node_modules/typescript-language-server/lib/cli.mjs",
            "--stdio"
          ],
          "root_markers": [
            "tsconfig.json",
            "jsconfig.json",
            "package.json"
          ],
          "root_strategy": "nearest",
          "root_fallback": "workspace",
          "priority": 10,
          "bindings": [
            {
              "language": "javascript",
              "language_id": "javascript"
            },
            {
              "language": "typescript",
              "variant": "typescript",
              "language_id": "typescript"
            },
            {
              "language": "typescript",
              "variant": "tsx",
              "language_id": "typescriptreact"
            }
          ],
          "initialization_options": {
            "tsserver": {
              "path": "${extension}/node_modules/typescript/lib/tsserver.js"
            }
          }
        }
      ]
    }
  }
}
