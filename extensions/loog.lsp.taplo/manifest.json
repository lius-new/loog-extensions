{
  "schema": 1,
  "id": "loog.lsp.taplo",
  "version": "0.1.0",
  "name": "Taplo Language Server",
  "publisher": "Loog",
  "description": "The Taplo language server.",
  "categories": [
    "Language Services"
  ],
  "keywords": [
    "taplo",
    "language server",
    "lsp"
  ],
  "license": "MIT",
  "repository": "https://github.com/lius-new/loog-extensions",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {
    "loog": ">=0.1.8 <0.3"
  },
  "capabilities": [
    "process.execute-local"
  ],
  "contributes": {
    "language_service": {
      "servers": [
        {
          "id": "loog.lsp.taplo.taplo",
          "name": "Taplo",
          "languages": [
            "toml"
          ],
          "command": "${extension}/taplo",
          "args": [
            "lsp",
            "stdio"
          ],
          "root_markers": [
            ".taplo.toml",
            "taplo.toml"
          ],
          "root_strategy": "nearest",
          "root_fallback": "workspace",
          "bindings": [
            {
              "language": "toml",
              "language_id": "toml"
            }
          ]
        }
      ]
    }
  }
}
