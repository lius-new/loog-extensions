{
  "schema": 1,
  "id": "loog.lsp.vscode-langservers-extracted",
  "version": "0.1.4",
  "api": "loog:extension@0.1.0",
  "component": "extension.wasm",
  "activation": [{ "kind": "document", "selector": { "languages": ["json"] } }, { "kind": "event", "name": "workspace.files" }, { "kind": "event", "name": "document.open" }, { "kind": "event", "name": "document.change" }, { "kind": "event", "name": "document.close" }, { "kind": "event", "name": "document.save" }],
  "name": "JSON Language Server",
  "publisher": "Loog",
  "description": "JSON and JSON with Comments completion, validation and formatting.",
  "categories": [
    "Language Services"
  ],
  "keywords": [
    "json",
    "language server",
    "lsp"
  ],
  "license": "MIT",
  "repository": "https://github.com/lius-new/loog-extensions",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {
    "loog": ">=0.2.0 <0.3"
  },
  "capabilities": [
    "process.execute-local", "documents.read", "workspace.files.read", "workspace.files.write", "workspace.edit", "languages", "events", "settings"
  ],
  "requires": [
    "loog.runtime.node@^0.1.0"
  ],
  "contributes": {
    "languages": [
      { "id": "loog.lsp.vscode-langservers-extracted.json", "path": "languages/json/language.json" }
    ],
    "settings": [
      { "key": "loog.lsp.vscode-langservers-extracted.configuration", "kind": "string", "default": "{\"json\":{\"validate\":{\"enable\":true}}}" },
      { "key": "loog.lsp.vscode-langservers-extracted.initialization", "kind": "string", "default": "{\"provideFormatter\":true}" },
      { "key": "loog.lsp.vscode-langservers-extracted.performance", "kind": "boolean", "default": false }
    ],
    "language_service": {
      "name": "JSON Language Server",
      "providers": [
        { "id": "loog.lsp.vscode-langservers-extracted.diagnostics", "kind": "diagnostics", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.completion", "kind": "completion", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.hover", "kind": "hover", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.definition", "kind": "definition", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.document-symbols", "kind": "document-symbols", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.signature-help", "kind": "signature-help", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.formatting", "kind": "formatting", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.inlay-hints", "kind": "inlay-hints", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.code-actions", "kind": "code-actions", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.references", "kind": "references", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.workspace-symbols", "kind": "workspace-symbols", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.document-highlights", "kind": "document-highlights", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.rename", "kind": "rename", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.folding-ranges", "kind": "folding-ranges", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.selection-ranges", "kind": "selection-ranges", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.call-hierarchy", "kind": "call-hierarchy", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.type-hierarchy", "kind": "type-hierarchy", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.code-lens", "kind": "code-lens", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.format-on-type", "kind": "format-on-type", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.execute-command", "kind": "execute-command", "selector": { "languages": ["json"] } },
        { "id": "loog.lsp.vscode-langservers-extracted.highlights", "kind": "highlights", "selector": { "languages": ["json"] } }
      ]
    }
  }
}
