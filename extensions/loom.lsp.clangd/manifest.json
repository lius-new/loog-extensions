{
  "schema": 1,
  "id": "loom.lsp.clangd",
  "version": "0.1.3",
  "name": "clangd Language Server",
  "publisher": "Loom",
  "description": "The clangd language server.",
  "categories": [
    "Language Services"
  ],
  "keywords": [
    "clangd",
    "language server",
    "lsp"
  ],
  "license": "Apache-2.0 WITH LLVM-exception",
  "repository": "https://github.com/lius-new/loom-extensions",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {
    "loom": ">=0.1.8 <0.3"
  },
  "capabilities": [
    "process.execute-local"
  ],
  "contributes": {
    "language_service": {
      "servers": [
        {
          "id": "loom.lsp.clangd.clangd",
          "name": "clangd",
          "languages": [
            "c",
            "cpp",
            "objc"
          ],
          "command": "${extension}/bin/clangd",
          "root_markers": [
            "compile_commands.json",
            "compile_flags.txt",
            ".clangd"
          ],
          "root_strategy": "nearest",
          "root_fallback": "workspace",
          "bindings": [
            {
              "language": "c",
              "language_id": "c"
            },
            {
              "language": "cpp",
              "language_id": "cpp"
            },
            {
              "language": "objc",
              "language_id": "objective-c"
            }
          ]
        }
      ]
    }
  }
}
