{
  "schema": 1,
  "id": "loog.lsp.yaml-language-server",
  "version": "0.1.0",
  "name": "YAML Language Server Language Server",
  "publisher": "Loog",
  "description": "The YAML Language Server language server.",
  "categories": [
    "Language Services"
  ],
  "keywords": [
    "yaml language server",
    "language server",
    "lsp"
  ],
  "license": "MIT",
  "repository": "https://github.com/lius-new/loog-extensions",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {
    "loog": ">=0.1.8 <0.3"
  },
  "capabilities": [
    "process.execute-local"
  ],
  "requires": [
    "loog.runtime.node@^0.1.0"
  ],
  "contributes": {
    "language_service": {
      "servers": [
        {
          "id": "loog.lsp.yaml-language-server.yaml-language-server",
          "name": "YAML Language Server",
          "languages": [
            "yaml"
          ],
          "command": "${runtime.node}/node",
          "args": [
            "${extension}/node_modules/yaml-language-server/bin/yaml-language-server",
            "--stdio"
          ],
          "root_markers": [
            ".git"
          ],
          "root_strategy": "nearest",
          "root_fallback": "workspace",
          "bindings": [
            {
              "language": "yaml",
              "language_id": "yaml"
            }
          ]
        }
      ]
    }
  }
}
