{
  "schema": 1,
  "id": "loog.lsp.svelte-language-server",
  "version": "0.1.0",
  "api": "loog:extension@0.1.0",
  "component": "extension.wasm",
  "activation": [{ "kind": "document", "selector": { "languages": ["svelte"] } }, { "kind": "event", "name": "workspace.files" }, { "kind": "event", "name": "document.open" }, { "kind": "event", "name": "document.change" }, { "kind": "event", "name": "document.close" }, { "kind": "event", "name": "document.save" }],
  "name": "Svelte Language Server",
  "publisher": "Loog",
  "description": "Svelte diagnostics, completion and navigation with JavaScript and TypeScript support inside components.",
  "categories": [
    "Language Services"
  ],
  "keywords": [
    "svelte",
    "language server",
    "lsp"
  ],
  "license": "MIT",
  "repository": "https://github.com/lius-new/loog-extensions",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {
    "loog": ">=0.2.0 <0.3"
  },
  "capabilities": [
    "process.execute-local", "documents.read", "workspace.files.read", "workspace.files.write", "workspace.edit", "languages", "events", "settings"
  ],
  "requires": [
    "loog.runtime.node@^0.1.0"
  ],
  "contributes": {
    "languages": [
      { "id": "loog.lsp.svelte-language-server.svelte", "path": "languages/svelte/language.json" }
    ],
    "settings": [
      { "key": "loog.lsp.svelte-language-server.configuration", "kind": "string", "default": "{}" },
      { "key": "loog.lsp.svelte-language-server.initialization", "kind": "string", "default": "{}" },
      { "key": "loog.lsp.svelte-language-server.performance", "kind": "boolean", "default": false }
    ],
    "language_service": {
      "name": "Svelte Language Server",
      "providers": [
        { "id": "loog.lsp.svelte-language-server.diagnostics", "kind": "diagnostics", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.completion", "kind": "completion", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.hover", "kind": "hover", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.definition", "kind": "definition", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.document-symbols", "kind": "document-symbols", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.signature-help", "kind": "signature-help", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.formatting", "kind": "formatting", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.inlay-hints", "kind": "inlay-hints", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.code-actions", "kind": "code-actions", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.references", "kind": "references", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.workspace-symbols", "kind": "workspace-symbols", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.document-highlights", "kind": "document-highlights", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.rename", "kind": "rename", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.folding-ranges", "kind": "folding-ranges", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.selection-ranges", "kind": "selection-ranges", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.call-hierarchy", "kind": "call-hierarchy", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.type-hierarchy", "kind": "type-hierarchy", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.code-lens", "kind": "code-lens", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.format-on-type", "kind": "format-on-type", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.execute-command", "kind": "execute-command", "selector": { "languages": ["svelte"] } },
        { "id": "loog.lsp.svelte-language-server.highlights", "kind": "highlights", "selector": { "languages": ["svelte"] } }
      ]
    }
  }
}
