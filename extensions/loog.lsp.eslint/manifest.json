{
  "schema": 1,
  "id": "loog.lsp.eslint",
  "version": "0.1.0",
  "api": "loog:extension@0.1.0",
  "component": "extension.wasm",
  "activation": [{ "kind": "document", "selector": { "languages": ["javascript", "typescript"] } }, { "kind": "event", "name": "workspace.files" }, { "kind": "event", "name": "document.open" }, { "kind": "event", "name": "document.change" }, { "kind": "event", "name": "document.close" }, { "kind": "event", "name": "document.save" }],
  "name": "ESLint Language Server",
  "publisher": "Loog",
  "description": "ESLint diagnostics and quick fixes for JavaScript and TypeScript.",
  "categories": [
    "Language Services"
  ],
  "keywords": [
    "eslint",
    "language server",
    "lsp"
  ],
  "license": "MIT",
  "repository": "https://github.com/lius-new/loog-extensions",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {
    "loog": ">=0.2.0 <0.3"
  },
  "capabilities": [
    "process.execute-local", "documents.read", "workspace.files.read", "workspace.files.write", "workspace.edit", "languages", "events", "settings"
  ],
  "requires": [
    "loog.runtime.node@^0.1.0"
  ],
  "contributes": {
    "languages": [
      { "id": "loog.lsp.eslint.javascript", "path": "languages/javascript/language.json" },
      { "id": "loog.lsp.eslint.typescript", "path": "languages/typescript/language.json" }
    ],
    "settings": [
      { "key": "loog.lsp.eslint.configuration", "kind": "string", "default": "{\"validate\":\"on\",\"run\":\"onType\",\"packageManager\":\"npm\",\"nodePath\":null,\"options\":{},\"experimental\":{\"useFlatConfig\":false},\"rulesCustomizations\":[],\"format\":false,\"codeActionOnSave\":{\"enable\":false},\"codeAction\":{\"disableRuleComment\":{\"enable\":true,\"location\":\"separateLine\"},\"showDocumentation\":{\"enable\":true}},\"problems\":{\"shortenToSingleLine\":false}}" },
      { "key": "loog.lsp.eslint.initialization", "kind": "string", "default": "{}" },
      { "key": "loog.lsp.eslint.performance", "kind": "boolean", "default": false }
    ],
    "language_service": {
      "name": "ESLint Language Server",
      "providers": [
        { "id": "loog.lsp.eslint.diagnostics", "kind": "diagnostics", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.completion", "kind": "completion", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.hover", "kind": "hover", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.definition", "kind": "definition", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.document-symbols", "kind": "document-symbols", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.signature-help", "kind": "signature-help", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.formatting", "kind": "formatting", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.inlay-hints", "kind": "inlay-hints", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.code-actions", "kind": "code-actions", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.references", "kind": "references", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.workspace-symbols", "kind": "workspace-symbols", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.document-highlights", "kind": "document-highlights", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.rename", "kind": "rename", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.folding-ranges", "kind": "folding-ranges", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.selection-ranges", "kind": "selection-ranges", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.call-hierarchy", "kind": "call-hierarchy", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.type-hierarchy", "kind": "type-hierarchy", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.code-lens", "kind": "code-lens", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.format-on-type", "kind": "format-on-type", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.execute-command", "kind": "execute-command", "selector": { "languages": ["javascript", "typescript"] } },
        { "id": "loog.lsp.eslint.highlights", "kind": "highlights", "selector": { "languages": ["javascript", "typescript"] } }
      ]
    }
  }
}
