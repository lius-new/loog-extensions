{
  "schema": 1,
  "id": "loog.lsp.marksman",
  "version": "0.1.0",
  "name": "Marksman Language Server",
  "publisher": "Loog",
  "description": "The Marksman language server.",
  "categories": [
    "Language Services"
  ],
  "keywords": [
    "marksman",
    "language server",
    "lsp"
  ],
  "license": "MIT",
  "repository": "https://github.com/lius-new/loog-extensions",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {
    "loog": ">=0.1.8 <0.3"
  },
  "capabilities": [
    "process.execute-local"
  ],
  "contributes": {
    "language_service": {
      "servers": [
        {
          "id": "loog.lsp.marksman.marksman",
          "name": "Marksman",
          "languages": [
            "markdown"
          ],
          "command": "${extension}/marksman",
          "args": [
            "server"
          ],
          "root_markers": [
            ".marksman.toml",
            ".git"
          ],
          "root_strategy": "nearest",
          "root_fallback": "workspace",
          "bindings": [
            {
              "language": "markdown",
              "language_id": "markdown"
            }
          ]
        }
      ]
    }
  }
}
