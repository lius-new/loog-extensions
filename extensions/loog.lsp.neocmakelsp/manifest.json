{
  "schema": 1,
  "id": "loog.lsp.neocmakelsp",
  "version": "0.1.1",
  "api": "loog:extension@0.1.0",
  "component": "extension.wasm",
  "activation": [{ "kind": "document", "selector": { "languages": ["cmake"] } }, { "kind": "event", "name": "workspace.files" }, { "kind": "event", "name": "document.open" }, { "kind": "event", "name": "document.change" }, { "kind": "event", "name": "document.close" }, { "kind": "event", "name": "document.save" }],
  "name": "Neocmakelsp",
  "publisher": "Loog",
  "description": "CMake completion, navigation and formatting powered by Neocmakelsp.",
  "categories": [
    "Language Services"
  ],
  "keywords": [
    "cmake",
    "language server",
    "lsp"
  ],
  "license": "MIT",
  "repository": "https://github.com/lius-new/loog-extensions",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {
    "loog": ">=0.2.0 <0.3"
  },
  "capabilities": [
    "process.execute-local", "documents.read", "workspace.files.read", "workspace.files.write", "workspace.edit", "languages", "events", "settings"
  ],
  "contributes": {
    "languages": [
      { "id": "loog.lsp.neocmakelsp.cmake", "path": "languages/cmake/language.json" }
    ],
    "settings": [
      { "key": "loog.lsp.neocmakelsp.configuration", "kind": "string", "default": "{}" },
      { "key": "loog.lsp.neocmakelsp.initialization", "kind": "string", "default": "{}" },
      { "key": "loog.lsp.neocmakelsp.performance", "kind": "boolean", "default": false }
    ],
    "language_service": {
      "name": "Neocmakelsp",
      "providers": [
        { "id": "loog.lsp.neocmakelsp.diagnostics", "kind": "diagnostics", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.completion", "kind": "completion", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.hover", "kind": "hover", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.definition", "kind": "definition", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.document-symbols", "kind": "document-symbols", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.signature-help", "kind": "signature-help", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.formatting", "kind": "formatting", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.inlay-hints", "kind": "inlay-hints", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.code-actions", "kind": "code-actions", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.references", "kind": "references", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.workspace-symbols", "kind": "workspace-symbols", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.document-highlights", "kind": "document-highlights", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.rename", "kind": "rename", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.folding-ranges", "kind": "folding-ranges", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.selection-ranges", "kind": "selection-ranges", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.call-hierarchy", "kind": "call-hierarchy", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.type-hierarchy", "kind": "type-hierarchy", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.code-lens", "kind": "code-lens", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.format-on-type", "kind": "format-on-type", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.execute-command", "kind": "execute-command", "selector": { "languages": ["cmake"] } },
        { "id": "loog.lsp.neocmakelsp.highlights", "kind": "highlights", "selector": { "languages": ["cmake"] } }
      ]
    }
  }
}
