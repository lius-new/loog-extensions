{
  "schema": 1,
  "id": "loom.lsp.lua-language-server",
  "version": "0.1.1",
  "name": "Lua Language Server Language Server",
  "publisher": "Loom",
  "description": "The Lua Language Server language server.",
  "categories": [
    "Languages"
  ],
  "keywords": [
    "lua language server",
    "language server",
    "lsp"
  ],
  "license": "MIT",
  "repository": "https://github.com/lius-new/loom-extensions",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": {
    "loom": ">=0.1.8 <0.3"
  },
  "capabilities": [
    "process.execute-local"
  ],
  "contributes": {
    "language_servers": [
      {
        "id": "loom.lsp.lua-language-server.lua-language-server",
        "name": "Lua Language Server",
        "languages": [
          "lua"
        ],
        "command": "${extension}/bin/lua-language-server",
        "root_markers": [
          ".luarc.json",
          ".luarc.jsonc"
        ],
        "root_strategy": "nearest",
        "root_fallback": "workspace",
        "bindings": [
          {
            "language": "lua",
            "language_id": "lua"
          }
        ]
      }
    ]
  }
}
