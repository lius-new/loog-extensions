{
  "loog.lsp.gopls": {
    "languages": ["go"],
    "program": "${extension}/gopls",
    "args": [],
    "markers": ["go.work", "go.mod"],
    "outermost": false,
    "fileFallback": false
  },
  "loog.lsp.rust-analyzer": {
    "languages": ["rust"],
    "program": "${extension}/rust-analyzer",
    "args": [],
    "markers": ["Cargo.toml", "rust-project.json"],
    "outermost": true,
    "fileFallback": true
  },
  "loog.lsp.typescript-language-server": {
    "languages": ["javascript", "typescript"],
    "program": "${runtime.node}/node",
    "args": ["${extension}/node_modules/typescript-language-server/lib/cli.mjs", "--stdio"],
    "markers": ["tsconfig.json", "jsconfig.json", "package.json"],
    "outermost": false,
    "fileFallback": false
  },
  "loog.lsp.pyright": {
    "languages": ["python"],
    "program": "${runtime.node}/node",
    "args": ["${extension}/node_modules/pyright/langserver.index.js", "--stdio"],
    "markers": ["pyrightconfig.json", "pyproject.toml", "setup.py", "setup.cfg", "requirements.txt"],
    "outermost": false,
    "fileFallback": false
  },
  "loog.lsp.yaml-language-server": {
    "languages": ["yaml"],
    "program": "${runtime.node}/node",
    "args": ["${extension}/node_modules/yaml-language-server/bin/yaml-language-server", "--stdio"],
    "markers": [],
    "outermost": false,
    "fileFallback": false
  },
  "loog.lsp.bash-language-server": {
    "languages": ["bash"],
    "program": "${runtime.node}/node",
    "args": ["${extension}/node_modules/bash-language-server/out/cli.js", "start"],
    "markers": [],
    "outermost": false,
    "fileFallback": false
  },
  "loog.lsp.clangd": {
    "languages": ["c", "cpp", "objc"],
    "program": "${extension}/bin/clangd",
    "args": [],
    "markers": ["compile_commands.json", "compile_flags.txt", ".clangd"],
    "outermost": false,
    "fileFallback": false
  },
  "loog.lsp.lua-language-server": {
    "languages": ["lua"],
    "program": "${extension}/bin/lua-language-server",
    "args": [],
    "markers": [".luarc.json", ".luarc.jsonc"],
    "outermost": false,
    "fileFallback": false
  },
  "loog.lsp.taplo": {
    "languages": ["toml"],
    "program": "${extension}/taplo",
    "args": ["lsp", "stdio"],
    "markers": [".taplo.toml", "taplo.toml"],
    "outermost": false,
    "fileFallback": false
  },
  "loog.lsp.css-language-server": {
    "languages": ["css", "scss"],
    "program": "${runtime.node}/node",
    "args": ["${extension}/node_modules/vscode-langservers-extracted/bin/vscode-css-language-server", "--stdio"],
    "markers": ["package.json"],
    "outermost": false,
    "fileFallback": false
  },
  "loog.lsp.html-language-server": {
    "languages": ["html"],
    "program": "${runtime.node}/node",
    "args": ["${extension}/node_modules/vscode-langservers-extracted/bin/vscode-html-language-server", "--stdio"],
    "markers": ["package.json"],
    "outermost": false,
    "fileFallback": false
  },
  "loog.lsp.biome": {
    "languages": ["javascript", "typescript", "json", "css"],
    "program": "${extension}/biome",
    "args": ["lsp-proxy"],
    "markers": ["biome.json", "biome.jsonc"],
    "outermost": false,
    "fileFallback": false
  },
  "loog.lsp.marksman": {
    "languages": ["markdown"],
    "program": "${extension}/marksman",
    "args": ["server"],
    "markers": [".marksman.toml"],
    "outermost": false,
    "fileFallback": false
  },
  "loog.lsp.ruff": {
    "languages": ["python"],
    "program": "${extension}/ruff",
    "args": ["server"],
    "markers": ["ruff.toml", ".ruff.toml", "pyproject.toml"],
    "outermost": false,
    "fileFallback": false
  },
  "loog.lsp.vscode-langservers-extracted": {
    "languages": ["json"],
    "program": "${runtime.node}/node",
    "args": ["${extension}/node_modules/vscode-langservers-extracted/bin/vscode-json-language-server", "--stdio"],
    "markers": ["package.json"],
    "outermost": false,
    "fileFallback": false
  },
  "loog.lsp.eslint": {
    "languages": ["javascript", "typescript"],
    "program": "${runtime.node}/node",
    "args": ["${extension}/node_modules/vscode-langservers-extracted/bin/vscode-eslint-language-server", "--stdio"],
    "markers": ["eslint.config.js", "eslint.config.mjs", "eslint.config.cjs", ".eslintrc.json", ".eslintrc.js", ".eslintrc.cjs", ".eslintrc.yml", ".eslintrc.yaml", ".eslintrc", "package.json"],
    "outermost": false,
    "fileFallback": false
  },
  "loog.lsp.zls": {
    "languages": ["zig"],
    "program": "${extension}/zls",
    "args": [],
    "markers": ["build.zig", "build.zig.zon"],
    "outermost": false,
    "fileFallback": true
  }
}
